# fastlane gen_secrets가 Config/Secrets.xcconfig를 생성할 때 사용하는 "비민감" 기본값.
# 이 파일은 커밋된다. URL escape는 gen_secrets lane이 처리하므로 raw URL을 적는다.
#
# ⚠️ 진짜 시크릿(API 키/토큰 등)은 여기 적지 말 것.
#    - 로컬: fastlane/.env (비커밋)에 작성 → .env가 .env.default를 오버라이드
#    - CI:   GitHub Secrets → workflow env로 주입 (ENV가 .env.default보다 우선)

API_BASE_URL_DEBUG=https://dev.rundiary.app
API_BASE_URL_RELEASE=https://rundiary.app
