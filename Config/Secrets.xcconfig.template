// Secrets.xcconfig 템플릿
//
// 사용법(로컬):
//   1) `fastlane gen_secrets` 실행 → fastlane/.env(.default)의 값으로 자동 생성
//   2) 또는 이 파일을 복사: `cp Config/Secrets.xcconfig.template Config/Secrets.xcconfig`
//
// 실제 파일(Config/Secrets.xcconfig)은 .gitignore 대상이며 커밋되지 않습니다.
// 진짜 시크릿(API 키 등)은 이 템플릿에 적지 말고 fastlane/.env(비커밋) 또는 GitHub Secrets에 둡니다.
//
// 주의: xcconfig에서 `//`는 주석이므로 URL scheme의 `//`는 `/$()/`로 escape 한다.

API_BASE_URL_DEBUG = https:/$()/dev.rundiary.app
API_BASE_URL_RELEASE = https:/$()/rundiary.app
